---
/**
 * Ein Flug als Bordkarte, wie in der Reise-Ansicht der App: große IATA-Codes, eine gestrichelte Linie mit Flugzeug,
 * Abriss-Kerben am Rand und kleine Versal-Felder im Abschnitt darunter.
 */
interface Props {
  from: { code: string; city: string };
  to: { code: string; city: string };
  /** Kopfzeile links, z. B. das Datum. */
  date: string;
  /** Kopfzeile rechts, z. B. die Flugdauer. */
  note?: string;
  fields: { label: string; value: string }[];
}

const { from, to, date, note, fields } = Astro.props;
---

<article class="ticket" aria-label={`Bordkarte von ${from.city} nach ${to.city}`}>
  <div class="top">
    <p class="row label">
      <span>{date}</span>
      {note && <span>{note}</span>}
    </p>
    <div class="row route">
      <div class="end">
        <span class="code">{from.code}</span>
        <span class="city">{from.city}</span>
      </div>
      <div class="path" aria-hidden="true">
        <span class="dash"></span>
        <svg viewBox="0 0 24 24" width="18" height="18">
          <path
            d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
          ></path>
        </svg>
        <span class="dash"></span>
      </div>
      <div class="end end-to">
        <span class="code">{to.code}</span>
        <span class="city">{to.city}</span>
      </div>
    </div>
  </div>
  <dl class="row stub">
    {
      fields.map((f) => (
        <div>
          <dt class="label">{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))
    }
  </dl>
</article>

<style>
  /* Die Kerben sitzen auf Höhe des Abrisses, gemessen von unten; der Schatten folgt der Form. */
  .ticket {
    --stub: 76px;
    --notch: 9px;
    position: relative;
    isolation: isolate;
    max-width: 26rem;
    filter: drop-shadow(var(--shadow-card));
  }

  .ticket::before,
  .ticket::after {
    content: '';
    position: absolute;
    z-index: -1;
  }

  /* Außen der Rand, innen das Papier, beide mit derselben Kerbe ausgestanzt. */
  .ticket::before {
    inset: 0;
    background: var(--card-border);
    border-radius: var(--radius-lg);
    mask:
      radial-gradient(circle at 0 calc(100% - var(--stub)), transparent var(--notch), #000 calc(var(--notch) + 0.5px)) left / 51% 100% no-repeat,
      radial-gradient(circle at 100% calc(100% - var(--stub)), transparent var(--notch), #000 calc(var(--notch) + 0.5px)) right / 51% 100% no-repeat;
  }

  .ticket::after {
    inset: 1px;
    background: var(--surface);
    border-radius: calc(var(--radius-lg) - 1px);
    mask:
      radial-gradient(circle at -1px calc(100% - var(--stub) + 1px), transparent calc(var(--notch) + 1px), #000 calc(var(--notch) + 1.5px)) left / 51% 100% no-repeat,
      radial-gradient(circle at calc(100% + 1px) calc(100% - var(--stub) + 1px), transparent calc(var(--notch) + 1px), #000 calc(var(--notch) + 1.5px)) right / 51% 100% no-repeat;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0;
  }

  .top {
    padding: var(--space-4) 18px var(--space-3);
  }

  .route {
    align-items: flex-start;
    margin-top: var(--space-2);
  }

  .end {
    display: flex;
    flex-direction: column;
  }

  .end-to {
    align-items: flex-end;
    text-align: right;
  }

  .code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.875rem;
    line-height: 1.15;
    letter-spacing: 0.03em;
  }

  .city {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .path {
    flex: 1;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 2.15rem;
    min-width: 3rem;
  }

  .dash {
    flex: 1;
    border-top: 1.5px dashed var(--stamp-edge);
  }

  .path svg {
    flex: none;
    transform: rotate(90deg);
    fill: var(--primary);
  }

  .stub {
    height: var(--stub);
    align-items: center;
    padding: 0 18px;
    border-top: 1.5px dashed var(--border);
    margin-inline: var(--notch);
    padding-inline: calc(18px - var(--notch));
  }

  .stub div {
    min-width: 0;
  }

  .stub dt {
    font-size: 0.6875rem;
  }

  .stub dd {
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
